# kit/project.env: Mentoring Minds. Read by every kit script. No secrets in this file.
PROJECT=mentoring-minds
REPO_URL=https://github.com/smb-products/mentoring-minds.git

# Team: names map to agent files (osa, lead, builder, checker, ops)
LEADS="axis zero"
BUILDERS="soap fantem kade"
CHECKERS="rigg"
OPS="atlas"

# Messages: OPS_ISSUE is the pinned "Ops" issue (Atlas creates it). The repo is public: no secrets, no real data.
MSG_BACKEND=
OPS_ISSUE=

# Commands (npm, Postgres via Prisma, Vitest + Playwright).
INSTALL_CMD="npm ci"
INSTALL_CHECK_CMD="npm ci --prefer-offline"
WT_SETUP_CMD="npm ci --prefer-offline"
WT_COPY=""   # lanes copy no env files: they get LANE_ENV below
TYPECHECK_CMD="npm run typecheck"
TEST_RELATED_CMD="npx vitest related --run --passWithNoTests {files}"
FULL_TEST_CMD="npm run typecheck && npm test && npm run build:e2e && npm run test:e2e"
DEV_PORT=3000

# Lane env. No secrets: the fake values from .github/workflows/ci.yml.
# LANE_SETUP_CMD runs once when lanes start (kit/seat.sh), idempotently: a postgres:16 container mentoring-pg on
# 127.0.0.1:54330 (not 5432, which other projects may use) with databases mm_dev, mm_test and mm_e2e_test.
# LANE_ENV is exported inside every lane's tmux session. It overrides any env file, so lanes never reach a real service.
LANE_SETUP_CMD='! docker inspect mentoring-pg >/dev/null 2>&1 || docker inspect -f "{{json .HostConfig.PortBindings}}" mentoring-pg | grep -q 54330 || docker rm -f mentoring-pg >/dev/null; if docker start mentoring-pg >/dev/null 2>&1 || docker run -d --name mentoring-pg --restart unless-stopped -p 127.0.0.1:54330:5432 -e POSTGRES_PASSWORD=postgres postgres:16 >/dev/null; then for i in $(seq 60); do docker exec mentoring-pg pg_isready -q -h 127.0.0.1 -U postgres && break; sleep 1; done; for d in mm_dev mm_test mm_e2e_test; do docker exec mentoring-pg createdb -h 127.0.0.1 -U postgres "$d" >/dev/null 2>&1 || true; done; else echo "lanes: postgres mentoring-pg did not start (docker); database work will fail" >&2; fi'
LANE_ENV='export DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/mm_dev DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54330/mm_dev TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/mm_test DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:54330/mm_test E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54330/mm_e2e_test AUTH_SECRET=ci-only-secret-not-used-anywhere-else INVITE_PEPPER=ci-only-pepper NEXT_TELEMETRY_DISABLED=1'

# Who may touch what. The acceptance specs (tests/e2e/auth.spec.ts, tests/e2e/w*.spec.ts) are locked.
PROTECT_WRITE="plan/features.json RULES.md CLAUDE.md AGENTS.md CHANGES.md docs/* kit/* .claude/* .github/* tests/e2e/auth.spec.ts tests/e2e/w*.spec.ts"
PROTECT_MERGE="prisma/* prisma/schema.prisma prisma/migrations/* src/server/* src/lib/* src/app/api/* plan/features.json RULES.md CLAUDE.md AGENTS.md CHANGES.md docs/* kit/* .claude/* .github/* package.json package-lock.json"

# Lanes. kit/preflight.sh gates every start; kit/guard.sh watches them (GUARD_CAPS="<soft> <hard>" USD, none by default).
MAX_TURNS=100
MAX_ATTEMPTS=2
FEATURE_BUDGET_USD=10
# Files every wiring ticket edits on its own lines (index.js: one LIVE line per area, a header line between
# tickets), so git merges them cleanly. They never block a parallel claim.
SHARED_TOUCHES="src/ui/api/index.js"
# Watchdog: a session silent this long is hung; lane.py kills its process tree and resumes it.
WATCHDOG_SILENT_MIN=15
WATCHDOG_RESUMES=2
BUILD_MODEL=
CHECK_MODEL=sonnet
CHECK_BATCH=6
# A checker starts with CHECK_MIN merged features waiting, or once the oldest has waited CHECK_WAIT_MIN.
CHECK_MIN=3
CHECK_WAIT_MIN=30
# kit/watch.py wakes this lead when a held PR is green and waiting.
HELD_OWNER=zero
LANE_WAIT_S=60
LANE_WAIT_MAX_MIN=20
CLAUDE_FLAGS="--permission-mode acceptEdits"
CLAUDE_FLAGS_MIOSA="--dangerously-skip-permissions"
LANES_ON=local

# MIOSA (not used yet: lanes are local). One workspace for this project when it is.
# IS_SANDBOX=1 lets claude --dangerously-skip-permissions run as root. --always-on: pause it yourself (kit/miosa.sh pause).
# Logins: kit/SETUP.md "Logging in the workspace"; preflight there proves them with a real claude -p and a gh write.
# Placeholders: {ws} workspace id, {snap} snapshot id, {name}, {port}, {idle} minutes.
MIOSA_CREATE_BASE='miosa create {name} --size medium --env mentoring-minds --always-on -e IS_SANDBOX=1 --tag project=mentoring-minds --wait --wait-timeout 5m --json'
MIOSA_CREATE='miosa create {name} --from {snap} --size medium --env mentoring-minds --always-on -e IS_SANDBOX=1 --tag project=mentoring-minds --wait --wait-timeout 5m --json'
MIOSA_RESUME='miosa resume {ws} --wait'
MIOSA_EXEC='miosa ssh {ws} --'
MIOSA_SHELL='miosa console {ws}'
MIOSA_SNAPSHOT='miosa snapshot save {ws} {name}-base --json'
MIOSA_PAUSE='miosa pause {ws}'
MIOSA_DELETE='miosa destroy {ws} --yes'
MIOSA_PREVIEW='miosa preview create {ws} {port} --name {name}'
MIOSA_ID_FIELD=id
MIOSA_REPO_DIR=/root/repo
MIOSA_IDLE_PAUSE_MIN=30
MIOSA_MAX_WORKSPACES=2
MIOSA_RATE_USD_H=0.1785
MIOSA_PASS_ENV=""   # nothing from the laptop: the environment passes Claude and GitHub
MIOSA_DEV_ENV_FILE=""   # lanes use LANE_ENV (committed placeholders), so nothing is copied in
# bootstrap and lanes run LANE_SETUP_CMD and LANE_ENV in the workspace before installing.
REAL_DATA=0   # demo data only, everywhere
