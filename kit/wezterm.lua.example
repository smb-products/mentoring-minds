-- ~/.wezterm.lua (or ~/.config/wezterm/wezterm.lua). Copy this file there and edit the paths.
local wezterm = require 'wezterm'
local config = wezterm.config_builder()

-- Load the AVEL module from one of the client repos (any repo with the kit works).
package.path = package.path .. ';' .. wezterm.home_dir .. '/code/mentoring-minds/kit/?.lua'
local avel = require 'avel'

config.font_size = 13
config.color_scheme = 'Builtin Solarized Dark'
config.window_decorations = 'RESIZE'
config.use_fancy_tab_bar = false
config.scrollback_lines = 20000

return avel.apply(config, {
  { name = 'mentoring-minds', dir = wezterm.home_dir .. '/projects/mm-app', autostart = true },
})
