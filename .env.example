# ── Copy to .env. Production values go in Vercel → Settings → Environment Variables (docs/DEPLOY.md).

# Sign-in is always on. To try the app locally, run `npm run db:seed:demo`, then sign in with
# the demo accounts it lists (Vienne, or any demo parent).

# Postgres. Local: createdb mm_dev. Production: Neon's POOLED url (host has "-pooler").
DATABASE_URL="postgresql://postgres@localhost:5432/mm_dev"
# Migrations: Neon's DIRECT (unpooled) url. Locally, the same as DATABASE_URL.
DIRECT_URL="postgresql://postgres@localhost:5432/mm_dev"
# Tests empty this database on every run; its name must contain "test".
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/mm_test"

# Auth.js: generate with `npx auth secret`
AUTH_SECRET=""
# Google sign-in. Redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Local `npm start` only (Vercel sets this itself)
# AUTH_TRUST_HOST=true

# Invite codes are stored as SHA-256(code + pepper). Long random string. Never change it after launch.
INVITE_PEPPER=""

# File storage: a PRIVATE Vercel Blob store. Vercel adds these when you connect the store
# ("Add a read-write token"); `vercel env pull` brings them here. Leave empty to use ./uploads locally.
BLOB_READ_WRITE_TOKEN=""
# Only for trying a production build on your own machine without Blob (`npm run build && npm start`):
# keeps uploads in ./uploads. Never set this on Vercel; its disk is wiped between requests.
# ALLOW_LOCAL_UPLOADS="true"

# Vercel Cron sends this as "Authorization: Bearer …" to /api/cron/daily (letters and numbers, 16+).
CRON_SECRET=""

# PWA push (optional): npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:vienne@example.com"

# Seeding Vienne's account (npm run db:seed). Use her Google address for Google sign-in.
ADMIN_EMAIL=""
ADMIN_NAME="Vienne Elliott"
# ADMIN_PASSWORD=""   # optional, for email sign-in
