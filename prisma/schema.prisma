// Mentoring Minds — data model.
// Mirrors the prototype's mock collections 1:1 (mm-proto/src/api/seed.js) and CONTRACT.md.
//
// Postgres everywhere: a local Postgres or a Neon branch in development, Neon in
// production (docs/COSTS.md). Lists (modes, benchmarkCodes, answers…) are Json.
// All timestamps are UTC; slots are computed in Settings.timezone (America/New_York).
//
// Florida B.E.S.T. standards and FAST reporting categories are static reference
// data in src/lib/best.ts, not tables.

// Rust-free client: queries run through the `pg` driver (src/lib/db.ts). No engine
// binary to bundle, which keeps serverless functions small and cold starts quick.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
  engineType      = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Neon: the direct (unpooled) URL, used by migrations
}

enum Role {
  ADMIN
  PARENT
}

enum UserStatus {
  PREVIEW // signed up, no child or invite code yet: can look, can't open or book. J2 makes new sign-ups ACTIVE
  ACTIVE
  PAUSED
}

enum TextSize {
  NORMAL
  LARGE
  XLARGE
}

enum StudentStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum LocationKind {
  TUTOR
  HOME
  LIBRARY
}

enum SessionMode {
  IN_PERSON
  VIDEO
}

enum SessionStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Attendance {
  PRESENT
  LATE
  ABSENT
}

enum NoteSource {
  TYPED // the only source since the AI features were removed (S33)
}

enum ResourceKind {
  WORKSHEET
  VIDEO
  LINK
  NOTE
  IMAGE
}

enum Visibility {
  ALL
  GRADES
  SELECTED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum AssignmentKind {
  BOOK // questions from the test-prep book, answered on the digital answer sheet
  PRACTICE // a link or resource, marked done
}

enum SubmissionStatus {
  ASSIGNED
  SUBMITTED // has written (OPEN) answers waiting for Vienne
  GRADED
  RETURNED
}

enum ItemFormat {
  MC // one letter A–D
  MULTI // several letters A–F
  NUMERIC // number, decimal or fraction
  OPEN // shown work, photo, Vienne marks it
}

enum KeySource {
  TYPED // the only source since the AI features were removed (S33)
}

enum RedoSource {
  ANSWER_SHEET
  SESSION
}

enum TestType {
  FAST_MATH // grades 3–6
  STAR_MATH // K–2 (Renaissance Star)
}

enum FastWindow {
  PM1
  PM2
  PM3
}

enum Audience {
  ADMIN
  PARENT
}

enum Channel {
  IN_APP
  PUSH
  EMAIL
}

/**
 * ── Accounts and families ───────────────────────────────
 */

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  emailVerified      DateTime?
  name               String
  phone              String?
  image              String?
  passwordHash       String? // null for Google-only users
  role               Role       @default(PARENT)
  status             UserStatus @default(PREVIEW)
  textSize           TextSize   @default(NORMAL)
  /// Password sign-in lockout: 5 wrong passwords lock the account for 15 minutes.
  failedLogins       Int        @default(0)
  lockedUntil        DateTime?
  /// Set when Vienne resets the password: the screens ask for a new one (families.changePassword).
  mustChangePassword Boolean    @default(false)
  /// Bumped when the password changes or is reset: every session issued before then is signed out.
  sessionVersion     Int        @default(0)
  /// Invite-code guessing limit: 10 wrong codes lock code entry for an hour.
  redeemFailures     Int        @default(0)
  redeemLockedUntil  DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  accounts      Account[]
  students      Student[]          @relation("ParentStudents")
  conversation  Conversation?      @relation("FamilyThread")
  messages      Message[]
  notifications Notification[]
  requested     Session[]          @relation("RequestedBy")
  cancelled     Session[]          @relation("CancelledBy")
  uploads       FileAsset[]
  submitted     Submission[]       @relation("SubmittedBy")
  inviteUsed    Invite?            @relation("InviteUsedBy")
  fastEntered   FastResult[]
  pushSubs      PushSubscription[]
  redeemFails   RedeemFailure[]
}

/// One wrong invite code. Counted across all accounts so many free accounts can't
/// share the guessing (src/server/invites.ts, GLOBAL_REDEEM_FAILURES_PER_HOUR).
model RedeemFailure {
  id     String   @id @default(cuid())
  userId String
  at     DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([at])
}

/// Auth.js linked logins (Google).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Invite {
  id              String    @id @default(cuid())
  codeHash        String    @unique // SHA-256(code + INVITE_PEPPER)
  codeHint        String // "MM-••4Q" for Vienne's list
  parentName      String
  parentEmail     String?
  plannedStudents Json // [{ firstName, lastName, grade, school? }]
  expiresAt       DateTime
  usedAt          DateTime?
  usedById        String?   @unique
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  usedBy          User?     @relation("InviteUsedBy", fields: [usedById], references: [id])
}

model Student {
  id          String        @id @default(cuid())
  parentId    String
  firstName   String
  lastName    String
  grade       Int // 0 = K … 6
  school      String? // Miami-Dade school name, free text
  schoolYear  String? // "2026–27"
  goals       String?
  adminNotes  String? // Vienne only
  avatarColor String        @default("brand")
  status      StudentStatus @default(ACTIVE)
  hasBookAt   DateTime? // family confirmed they have this grade's book; cleared on grade change
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  parent      User             @relation("ParentStudents", fields: [parentId], references: [id])
  sessions    Session[]
  submissions Submission[]
  reports     ProgressReport[]
  shares      ResourceShare[]
  redoItems   RedoItem[]
  fastResults FastResult[]
  subjects    StudentSubject[]

  @@index([parentId])
}

/**
 * ── Taxonomy: Vienne's skills (math only) ───────────────
 */

/// Kept so the product isn't boxed in; seeded with Math only and hidden in the UI.
model Subject {
  id          String           @id @default(cuid())
  name        String           @unique
  color       String
  order       Int              @default(0)
  archivedAt  DateTime?
  skills      Skill[]
  resources   Resource[]
  sessions    Session[]
  assignments Assignment[]
  students    StudentSubject[]
}

model StudentSubject {
  studentId String
  subjectId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([studentId, subjectId])
}

model Skill {
  id             String             @id @default(cuid())
  subjectId      String
  name           String // "Fractions"
  strand         String // B.E.S.T. strand: NSO FR AR M GR DP
  gradeMin       Int
  gradeMax       Int
  benchmarkCodes Json               @default("[]") // ["MA.4.FR.1.2", …] — maps the skill to FAST areas
  order          Int                @default(0)
  archivedAt     DateTime? // archive, never delete
  subject        Subject            @relation(fields: [subjectId], references: [id])
  ratings        ReportRating[]
  notes          SessionNoteSkill[]
}

/**
 * ── Scheduling ──────────────────────────────────────────
 */

model Location {
  id       String       @id @default(cuid())
  name     String
  kind     LocationKind
  address  String?
  active   Boolean      @default(true)
  sessions Session[]
}

/// Weekly recurring hours.
model Availability {
  id       String @id @default(cuid())
  weekday  Int // 0 = Sun … 6 = Sat
  startMin Int // minutes from midnight in Settings.timezone
  endMin   Int
  modes    Json   @default("[\"IN_PERSON\",\"VIDEO\"]") // what this block offers
}

model TimeOff {
  id       String   @id @default(cuid())
  startsAt DateTime
  endsAt   DateTime
  reason   String?
}

/// Single row (id = 1).
model Settings {
  id                Int     @id @default(1)
  timezone          String  @default("America/New_York")
  sessionLengths    Json    @default("[30,45,60]")
  slotStepMin       Int     @default(15)
  minNoticeHours    Int     @default(24)
  cancelCutoffHours Int     @default(24)
  horizonWeeks      Int     @default(4)
  defaultMeetingUrl String? // Vienne's Meet/Zoom room
  joinOpensMin      Int     @default(15)
  fastWindows       Json    @default("[]") // [{ window, schoolYear, startsAt, endsAt }]
}

model Session {
  id             String        @id @default(cuid())
  studentId      String
  subjectId      String
  mode           SessionMode   @default(IN_PERSON)
  locationId     String? // required for IN_PERSON
  address        String? // required when location kind = HOME
  meetingUrl     String? // VIDEO: set on confirm from Settings.defaultMeetingUrl
  requestedById  String
  startsAt       DateTime
  endsAt         DateTime
  durationMin    Int
  status         SessionStatus @default(REQUESTED)
  parentNote     String?
  declineReason  String?
  confirmedAt    DateTime?
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?
  callStartedAt  DateTime? // someone pressed Join call
  callEndedAt    DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student     Student      @relation(fields: [studentId], references: [id])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  location    Location?    @relation(fields: [locationId], references: [id])
  requestedBy User         @relation("RequestedBy", fields: [requestedById], references: [id])
  cancelledBy User?        @relation("CancelledBy", fields: [cancelledById], references: [id])
  note        SessionNote?

  @@index([startsAt])
  @@index([studentId, startsAt])
}

model SessionNote {
  id               String             @id @default(cuid())
  sessionId        String             @unique
  attendance       Attendance
  summary          String
  homework         String?
  sharedWithParent Boolean            @default(true)
  source           NoteSource         @default(TYPED)
  skills           SessionNoteSkill[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  session          Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SessionNoteSkill {
  sessionNoteId String
  skillId       String
  note          SessionNote @relation(fields: [sessionNoteId], references: [id], onDelete: Cascade)
  skill         Skill       @relation(fields: [skillId], references: [id])

  @@id([sessionNoteId, skillId])
}

/**
 * ── Content ─────────────────────────────────────────────
 */

model FileAsset {
  id           String       @id @default(cuid())
  storageKey   String       @unique
  filename     String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  /// null until the browser has finished uploading the bytes and the server has checked them.
  uploadedAt   DateTime?
  createdAt    DateTime     @default(now())
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  resources    Resource[]
  submissions  Submission[]
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  resources ResourceTag[]
}

model Resource {
  id            String        @id @default(cuid())
  title         String
  description   String?
  kind          ResourceKind
  subjectId     String?
  gradeMin      Int           @default(0)
  gradeMax      Int           @default(6)
  fileId        String?
  thumbnailId   String?
  url           String?
  body          Json?
  visibility    Visibility    @default(ALL)
  status        PublishStatus @default(DRAFT)
  showInPreview Boolean       @default(false)
  deletedAt     DateTime? // in the bin (Undo), purged after 30 days
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subject     Subject?        @relation(fields: [subjectId], references: [id])
  file        FileAsset?      @relation(fields: [fileId], references: [id])
  tags        ResourceTag[]
  shares      ResourceShare[]
  assignments Assignment[]
}

model ResourceTag {
  resourceId String
  tagId      String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
}

model ResourceShare {
  resourceId String
  studentId  String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([resourceId, studentId])
}

/**
 * ── The book ────────────────────────────────────────────
 */

/// One per grade: "Florida Test Prep F.A.S.T. Mathematics, Grade 5".
model Book {
  id          String       @id @default(cuid())
  title       String
  grade       Int          @unique
  tests       Json // [{ key: "M1", name: "Mini-test 1", count: 12 }, … "T4"]
  buyUrl      String?
  createdAt   DateTime     @default(now())
  items       BookItem[]
  assignments Assignment[]
}

/// Where a question is, what it tests and Vienne's answer. Never the question text.
model BookItem {
  id            String     @id @default(cuid())
  bookId        String
  test          String // "M1" … "T4"
  number        Int
  format        ItemFormat
  choiceCount   Int?
  answer        String? // admin-only; never sent to families. null for OPEN
  benchmarkCode String? // "MA.5.FR.2.1"
  points        Int        @default(1)
  source        KeySource  @default(TYPED)
  book          Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  redoItems     RedoItem[]

  @@unique([bookId, test, number])
}

/**
 * ── Assignments ─────────────────────────────────────────
 */

model Assignment {
  id           String         @id @default(cuid())
  title        String // "Test 1, #1–20"
  instructions String?
  kind         AssignmentKind
  subjectId    String?
  resourceId   String?
  bookId       String?
  bookTest     String?
  bookFrom     Int?
  bookTo       Int?
  dueAt        DateTime?
  createdAt    DateTime       @default(now())
  subject      Subject?       @relation(fields: [subjectId], references: [id])
  resource     Resource?      @relation(fields: [resourceId], references: [id])
  book         Book?          @relation(fields: [bookId], references: [id])
  submissions  Submission[]
}

/// Created on assign = the student's to-do.
model Submission {
  id            String           @id @default(cuid())
  assignmentId  String
  studentId     String
  status        SubmissionStatus @default(ASSIGNED)
  draft         Json? // [{ number, value }] saved as the child goes
  answers       Json? // [{ number, value, correct: true|false|null }] snapshotted at hand-in
  photos        Json             @default("[]") // [{ number, fileId }] for OPEN items
  fileId        String? // PRACTICE: optional uploaded work
  autoScore     Int?
  score         Int?
  maxScore      Int?
  feedback      String?
  stars         Int              @default(0)
  submittedById String?
  submittedAt   DateTime?
  gradedAt      DateTime?
  assignment    Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId], references: [id])
  submittedBy   User?            @relation("SubmittedBy", fields: [submittedById], references: [id])
  file          FileAsset?       @relation(fields: [fileId], references: [id])
  redoItems     RedoItem[]

  @@unique([assignmentId, studentId])
}

/// Book questions a student should try again, until Vienne clears them.
model RedoItem {
  id           String      @id @default(cuid())
  studentId    String
  bookItemId   String
  source       RedoSource
  submissionId String?
  createdAt    DateTime    @default(now())
  clearedAt    DateTime?
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bookItem     BookItem    @relation(fields: [bookItemId], references: [id], onDelete: Cascade)
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([studentId, clearedAt])
}

/**
 * ── FAST / Star Math results ────────────────────────────
 */

/// Entered by Vienne or the student's parent; `enteredById` says who.
model FastResult {
  id          String     @id @default(cuid())
  studentId   String
  testType    TestType
  schoolYear  String // "2026–27"
  window      FastWindow
  gradeTested Int
  scaleScore  Int
  level       Int? // FAST 1–5
  percentile  Int? // Star Math percentile rank
  categories  Json       @default("[]") // [{ categoryId: "rc_5_frac", level }]
  enteredById String
  enteredAt   DateTime   @default(now())
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy   User       @relation(fields: [enteredById], references: [id])

  @@unique([studentId, schoolYear, window])
}

/**
 * ── Progress reports ────────────────────────────────────
 */

model ProgressReport {
  id          String         @id @default(cuid())
  studentId   String
  periodStart DateTime
  periodEnd   DateTime
  summary     String
  status      PublishStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  student     Student        @relation(fields: [studentId], references: [id])
  ratings     ReportRating[]
}

model ReportRating {
  id       String         @id @default(cuid())
  reportId String
  skillId  String
  rating   Int // 1–4
  comment  String?
  report   ProgressReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  skill    Skill          @relation(fields: [skillId], references: [id])

  @@unique([reportId, skillId])
}

/**
 * ── Messages and notifications ──────────────────────────
 */

model Conversation {
  id               String    @id @default(cuid())
  parentId         String    @unique
  lastMessageAt    DateTime  @default(now())
  adminLastReadAt  DateTime?
  parentLastReadAt DateTime?
  parent           User      @relation("FamilyThread", fields: [parentId], references: [id])
  messages         Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Notification {
  id              String    @id @default(cuid())
  userId          String
  audience        Audience
  type            String
  title           String
  body            String?
  href            String?
  channel         Channel   @default(IN_APP)
  readAt          DateTime?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  /// S23b: the child or family the alert is about, set by the code that creates it. Deleting a child or a
  /// family removes alerts only through these ids, never by the names in the text. No foreign key: an
  /// alert is never refused because its child was just deleted.
  studentId       String?
  parentId        String?
  /// L2: the invite request this alert is about. The daily job deletes the alert with its request, by this
  /// id. No foreign key, like studentId and parentId.
  inviteRequestId String?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([studentId])
  @@index([parentId])
  @@index([inviteRequestId])
}

/// L2: a signed-out family asked for an invite. No account. Kept REQUEST_KEEP_DAYS, then the daily job deletes it.
model InviteRequest {
  id         String          @id @default(cuid())
  parentName String
  email      String
  phone      String?
  grade      Int
  message    String
  /// sha256(ip + ':' + INVITE_PEPPER), for the per-IP limit. Never the IP itself.
  ipHash     String
  createdAt  DateTime        @default(now())
  repeats    InviteAttempt[]

  @@index([createdAt])
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

/// L2: a request that was answered but not stored, because its email asked within DUPLICATE_EMAIL_HOURS.
/// It counts toward REQUESTS_PER_IP_PER_HOUR and REQUESTS_PER_HOUR next to the stored requests, so a repeat
/// uses up a slot like a new one. No name, email or message. The daily job deletes it after a day.
model InviteAttempt {
  id        String        @id @default(cuid())
  /// sha256(ip + ':' + INVITE_PEPPER), as on InviteRequest.
  ipHash    String
  /// The earlier request this one repeated. Deleted with it.
  requestId String
  createdAt DateTime      @default(now())
  request   InviteRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([requestId])
}

/// S36: one email sign-up (createAccount) that passed the form check, for SIGNUPS_PER_IP_PER_HOUR and
/// SIGNUPS_PER_HOUR. No name or email. The daily job deletes it after a day.
model SignupAttempt {
  id        String   @id @default(cuid())
  /// sha256(ip + ':' + INVITE_PEPPER), as on InviteRequest. Never the IP itself.
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

/// PWA push (phase 2). One row per device that allowed notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
